@startuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
left to right direction
hide empty members

package "Domain" {
    class "StudyProgram\n(studiengang.py)" as StudyProgram {
        +name: str
        +start_date: date
        +planned_semesters: int
        +required_ects: int
        +target_grade: float
        +student_name: str
        +semesters: list[Semester]
        +current_semester(today: date | None = None): int
    }

    class "Semester\n(semester.py)" as Semester {
        +number: int
        +start_date: date
        +end_date: date
        +modules: list[Module]
    }

    class "Module\n(modul.py)" as Module {
        +name: str
        +ects: int
        +assessment: Assessment
    }

    class "Assessment\n(pruefungsleistung.py)" as Assessment {
        +assessment_type: AssessmentType
        +status: AssessmentStatus
        +grade: float | None
    }

    enum "AssessmentType\n(pruefungsleistung.py)" as AssessmentType {
        EXAM
        WORKBOOK
        PORTFOLIO
        CASE_STUDY
        PROJECT_REPORT
        PROJECT_PRESENTATION
        TERM_PAPER
        SEMINAR_PAPER
    }

    enum "AssessmentStatus\n(pruefungsleistung.py)" as AssessmentStatus {
        OPEN
        IN_PROGRESS
        PASSED
        FAILED
    }
}

package "Persistence" {
    interface "StudyProgramRepository\n(repositories.py)" as StudyProgramRepository {
        +load(): StudyProgram | None
        +save(program: StudyProgram): None
    }

    class "SQLiteStudyProgramRepository\n(storage.py)" as SQLiteStudyProgramRepository {
        +load(): StudyProgram | None
        +save(program: StudyProgram): None
    }
}

package "Application" {
    class "DashboardService\n(dashboard.py)" as DashboardService {
        +build_dashboard_data(program: StudyProgram, today: date | None = None): DashboardData
    }

    class "DashboardController\n(controller.py)" as DashboardController {
        +load_dashboard_data(today: date | None = None): DashboardData
        +load_study_program(): StudyProgram | None
        +save_study_program(program: StudyProgram): None
        +add_module(semester_number: int, module: Module): None
        +update_module(semester_number: int, module_index: int, module: Module): None
        +import_study_program(path: Path): None
        +export_study_program(path: Path): None
    }
}

package "Data transfer / DTO" {
    class "DashboardData\n(dto.py)" as DashboardData {
        +program_name: str
        +student_name: str
        +current_semester: int
        +planned_semesters: int
        +remaining_semesters: int
        +required_ects: int
        +completed_ects: int
        +progress_percentage: float
        +expected_ects: int
        +target_grade: float
        +average_grade: float | None
        +time_status: TargetStatus
        +ects_status: TargetStatus
        +grade_status: TargetStatus
        +overall_status: OverallStatus
        +modules: tuple[ModuleDashboardRow, ...]
    }

    class "ModuleDashboardRow\n(dto.py)" as ModuleDashboardRow {
        +semester_number: int
        +module_name: str
        +ects: int
        +assessment_type: str
        +assessment_status: str
        +grade: float | None
    }

    enum "TargetStatus\n(dto.py)" as TargetStatus {
        ON_TRACK
        BEHIND
        NO_DATA
    }

    enum "OverallStatus\n(dto.py)" as OverallStatus {
        ON_TRACK
        AT_RISK
        OVERDUE
    }

    class "JSON transfer\n(transfer.py)" as JsonTransfer {
        +export_study_program(program: StudyProgram, path: Path): None
        +import_study_program(path: Path): StudyProgram
    }
}

package "Presentation" {
    class "DashboardView\n(ui.py)" as DashboardView {
        +run(): None
    }

    class "ProgressBar\n(ui.py)" as ProgressBar
}

package "Startup" {
    class "DashboardApplication\n(application.py)" as DashboardApplication {
        +start(): None
    }

    class "main\n(main.py)" as Main
}

StudyProgram "1" *-- "0..*" Semester
Semester "1" *-- "0..*" Module
Module "1" *-- "1" Assessment
Assessment ..> AssessmentType
Assessment ..> AssessmentStatus

SQLiteStudyProgramRepository ..|> StudyProgramRepository

DashboardService ..> StudyProgram
DashboardService ..> DashboardData
DashboardService ..> AssessmentStatus
DashboardController --> DashboardService
DashboardController --> StudyProgramRepository
DashboardController ..> StudyProgram
DashboardController ..> Module
DashboardController ..> JsonTransfer : imports/exports JSON
DashboardController ..> DashboardData

DashboardData *-- "0..*" ModuleDashboardRow
DashboardData ..> TargetStatus
DashboardData ..> OverallStatus

DashboardView --> DashboardController
DashboardView ..> DashboardData
ProgressBar --> DashboardView

DashboardApplication --> SQLiteStudyProgramRepository : creates
DashboardApplication --> DashboardService : creates
DashboardApplication --> DashboardController : wires
DashboardApplication --> DashboardView : starts
Main --> DashboardApplication : starts
@enduml
